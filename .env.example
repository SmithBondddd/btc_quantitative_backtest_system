# =============================================================================
#  环境变量模板 — 复制此文件为 .env 后填入真实值
#  Environment Template — Copy to .env and fill in real values
# =============================================================================

# 网络代理（国内环境需开启，海外服务器请留空）
# HTTP proxy (required in mainland China, leave blank on overseas servers)
HTTP_PROXY=
HTTPS_PROXY=

# API 凭证（为未来实盘预留）
# API credentials (reserved for live trading)
BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET_KEY=your_secret_key_here
